# Required environment variables for Census Tracker
#
# Local development:
#   Copy this file to .env.local and fill in values from the Firebase console
#   (Project settings → General → Your apps → SDK setup and configuration).
#
# Vercel deployment:
#   Set every variable below in the Vercel dashboard under
#   Project Settings → Environment Variables for the Production, Preview,
#   and Development environments. Build will silently fall back to empty
#   strings if any are missing (see src/lib/firebase.ts), which results in
#   hanging Firestore writes — so all six MUST be present.
#
# Build pipeline (framework, buildCommand, installCommand, region) is pinned
# declaratively in vercel.json.

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
