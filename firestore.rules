rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Census data - all authenticated users can read/write
    // This enables shared data between both clinical liaisons
    match /admissions/{docId} {
      allow read, write: if request.auth != null;
    }

    match /discharges/{docId} {
      allow read, write: if request.auth != null;
    }

    match /rtas/{docId} {
      allow read, write: if request.auth != null;
    }

    match /censusConfig/{docId} {
      allow read, write: if request.auth != null;
    }

    match /bonusSubmissions/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /activity/{docId} {
      allow read, write: if request.auth != null;
    }

    match /hospitals/{docId} {
      allow read, write: if request.auth != null;
    }

    match /dischargeFacilities/{docId} {
      allow read, write: if request.auth != null;
    }

    match /insuranceNames/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
