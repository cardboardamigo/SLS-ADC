rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Super users who are allowed to manually edit the bonus report
    function isSuperUser() {
      return request.auth != null
        && request.auth.token.email in ['jbrewer@slspecialty.org'];
    }

    // Users can read/write their own profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Bonus overrides — any authenticated user can read/write so all
    // clinical liaisons can adjust and print bonus reports.
    match /bonusOverrides/{docId} {
      allow read, write: if request.auth != null;
    }

    // Census data - all authenticated users can read/write
    // This enables shared data between both clinical liaisons
    match /admissions/{docId} {
      allow read, write: if request.auth != null;
    }

    match /discharges/{docId} {
      allow read, write: if request.auth != null;
    }

    match /rtas/{docId} {
      allow read, write: if request.auth != null;
    }

    match /censusConfig/{docId} {
      allow read, write: if request.auth != null;
    }

    match /bonusSubmissions/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /activity/{docId} {
      allow read, write: if request.auth != null;
    }

    match /hospitals/{docId} {
      allow read, write: if request.auth != null;
    }

    match /dischargeFacilities/{docId} {
      allow read, write: if request.auth != null;
    }

    match /insuranceNames/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
